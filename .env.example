# Copiar a .env y cambiar los valores. El .env real NUNCA se sube (artículo IX).
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=cambie-esta-clave
DB_PORT_HOST=5432

# php artisan key:generate --show
APP_KEY=base64:cambie-esto
# Cadena larga aleatoria (mínimo 32 caracteres)
JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambie-esta-clave

CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Rutas a los otros repos (por defecto, clonados uno al lado del otro)
API_PATH=../test-manager-library-3239137-api
APP_PATH=../test-manager-library-3239137-app
